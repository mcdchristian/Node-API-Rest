{
	"env": {
		"node": true,
		"es2021": true
	},
	"extends": ["eslint:recommended", "prettier"],
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
	"rules": {
		"no-console": "warn",
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
		"prefer-const": "error",
		"no-var": "error",
		"eqeqeq": ["error", "always"],
		"curly": "error",
		"brace-style": ["error", "1tbs"],
		"quotes": ["error", "single", { "avoidEscape": true }],
		"semi": ["error", "always"]
	},
	"plugins": ["prettier"]
}
